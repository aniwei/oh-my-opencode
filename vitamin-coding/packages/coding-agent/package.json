{
  "name": "@vitamin/coding-agent",
  "version": "0.0.1",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "vitamin": "./bin/vitamin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "build": "tsup && tsc -p tsconfig.json --emitDeclarationOnly",
    "typecheck:project": "tsc -p tsconfig.json --noEmit",
    "typecheck:file": "tsc src/index.ts --noEmit --target ES2024 --module ESNext --moduleResolution bundler --esModuleInterop --skipLibCheck",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@vitamin/agent": "workspace:*",
    "@vitamin/ai": "workspace:*",
    "@vitamin/config": "workspace:*",
    "@vitamin/extension": "workspace:*",
    "@vitamin/hooks": "workspace:*",
    "@vitamin/mcp": "workspace:*",
    "@vitamin/orchestrator": "workspace:*",
    "@vitamin/sdk": "workspace:*",
    "@vitamin/server": "workspace:^",
    "@vitamin/session": "workspace:*",
    "@vitamin/shared": "workspace:*",
    "@vitamin/tools": "workspace:*"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
